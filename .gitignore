# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Secrets / local env (keep .env.example)
.env
.env.*
!.env.example
kaggle.json
**/.kaggle/
**/access_token
credentials
secrets/
*.pem

# OS / IDE
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/

# Competition data (download locally or mount on Kaggle)
data/raw/*
!data/raw/.gitkeep

# Other generated reports stay local; keep the EDA HTML and overview index in git.
reports/**
!reports/.gitkeep
!reports/eda_report.html
!reports/index.html
!reports/vercel.json

# Vercel CLI link metadata (created during deploy)
.vercel/

# Large experiment artifacts (download from Kaggle / Actions)
oof/**
!oof/.gitkeep
submissions/**
!submissions/.gitkeep
models_ckpt/
logs/
*.lgb
*.bin
*.pkl
*.joblib
*.pt
*.pth
*.ckpt

# Kaggle / CI working copies
.kernel-staging/
.kernel-staging*/
kaggle/output/
artifacts/
